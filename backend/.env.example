# Copy to .env and adjust.

# Database — SQLite by default; PostgreSQL example:
# DATABASE_URL=postgresql+psycopg2://medorchestra:medorchestra@localhost:5432/medorchestra

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720

# Optional: enable Claude for natural-language understanding + coordination briefs.
# Without a key the system uses its built-in local NLP pipeline (fully offline).
# ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-opus-5
LLM_ENABLED=true

# Visual pacing between agent steps in the live trace (seconds). Set 0 for max speed.
AGENT_STEP_DELAY=0.35
SIMULATION_INTERVAL=8

HOSPITAL_NAME=CityCare Multispeciality Hospital
